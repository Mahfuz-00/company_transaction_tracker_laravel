APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Role granted to accounts created via public self-registration
REGISTRATION_DEFAULT_ROLE=Student

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# -----------------------------------------------------------------------------
# Platform branding (single source of truth)
#
# The master software name shown on the public pages (landing + login) and in
# the Software Super Admin's sidebar header. Change PLATFORM_NAME here and all
# three update together (see config/platform.php + usePlatformBranding()).
# These are PLATFORM values - never a tenant institution's name.
# -----------------------------------------------------------------------------
PLATFORM_NAME="SaaS Control Center"
PLATFORM_TAGLINE="Multi-institution meal & expense platform"
PLATFORM_ADMIN_SUBTITLE="Super Admin Portal"
PLATFORM_CONTROL_CENTER="SaaS Control Center"
PLATFORM_LOGO_PATH=

# -----------------------------------------------------------------------------
# Software Super Admin credential guardrails
#
# The SSA always has a working Profile Manager (name/avatar/password). Set these
# to false to LOCK IT DOWN so SSA credentials move ONLY via the CLI / seeder:
#   php artisan ssa:reset-password <email>
# Enforced centrally by App\Support\PasswordGuard.
# -----------------------------------------------------------------------------
PLATFORM_SSA_PROFILE_EDITABLE=true
PLATFORM_SSA_ALLOW_SELF_SERVICE_PASSWORD=true
VITE_APP_NAME="${APP_NAME}"
