<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <!--
        BROWSER TESTS ONLY.

        The suite is deliberately Dusk-only: every requirement is verified through
        a real browser against a real server, under tests/Browser/, rather than by
        unit tests that assert implementation details. There is therefore exactly
        ONE suite, and it is the one `php artisan dusk` runs via phpunit.dusk.xml.

        Keeping this file as a thin pointer means a stray `php artisan test` cannot
        silently report "0 tests" as a pass - it runs the browser suite.
    -->
    <testsuites>
        <testsuite name="Browser">
            <directory suffix="Test.php">tests/Browser</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <!-- No live sockets in any suite. -->
        <env name="SMTP_LIVE_CHECK" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PERMISSION_CACHE_ENABLED" value="false"/>
    </php>
</phpunit>
