<?xml version="1.0"?>
<ruleset name="Laravel Project Coding Standard">
    <description>Custom PHP_CodeSniffer ruleset for Laravel applications.</description>

    <!-- Directories to scan -->
    <file>app</file>
    <file>config</file>
    <file>database</file>
    <file>resources</file>
    <file>routes</file>

    <!-- Files and directories to exclude -->
    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>storage/*</exclude-pattern>
    <exclude-pattern>bootstrap/cache/*</exclude-pattern>
    <exclude-pattern>public/index.php</exclude-pattern>
    <exclude-pattern>*.blade.php</exclude-pattern>

    <!-- Generic PHPCS CLI Arguments -->
    <arg value="p"/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>
    <arg name="parallel" value="8"/>

    <!-- Use PSR-12 as the coding standard foundation -->
 

    <!-- Optional: Adjust or disable specific rules if needed -->
    <!-- Laravel heavily utilizes short arrays [], ensure they are allowed -->
    <rule ref="Generic.Arrays.DisallowShortArraySyntax">
        <severity>0</severity>
    </rule>
</ruleset>