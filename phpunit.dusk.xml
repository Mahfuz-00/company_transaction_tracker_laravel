<?xml version="1.0" encoding="UTF-8"?>
<phpunit backupGlobals="false"
         beStrictAboutTestsThatDoNotTestAnything="false"
         colors="true"
         processIsolation="false"
         stopOnError="false"
         stopOnFailure="false"
         cacheDirectory=".phpunit.cache"
         backupStaticProperties="false"
         bootstrap="tests/dusk-bootstrap.php">
    <testsuites>
        <testsuite name="Browser Test Suite">
            <directory suffix="Test.php">./tests/Browser</directory>
        </testsuite>
    </testsuites>
    <php>
        <!--
            Dusk boots a full Laravel app + browser driver per test class; on a
            large hierarchical suite that can exceed PHP's default 128M. Raise it
            here (test config only) so the run is not killed mid-suite.
        -->
        <ini name="memory_limit" value="2G"/>

        <!--
            HERMETIC BROWSER SUITE.

            These are set HERE, in the test configuration, rather than relying on
            `.env.dusk.local`. That file is git-ignored (it holds a real APP_KEY),
            so on a fresh clone or in CI it may be absent or stale - and when it is,
            the suite silently falls back to the DEFAULTS, which means:

              * SMTP_LIVE_CHECK defaults to TRUE -> SmtpConnectionChecker opens a
                real socket to smtp-relay.brevo.com on every SMTP save/check. The
                suite then depends on the network, is slow, and fails with
                "Connection failed" whenever the relay is unreachable or the
                credentials are fake (they are). This is the single cause of the
                SMTP flake cluster.

            Declaring it here makes the suite hermetic by CONSTRUCTION: no test can
            open a socket, no matter what the environment file says.
        -->
        <env name="SMTP_LIVE_CHECK" value="false"/>
        <env name="MAIL_MAILER" value="log"/>
        <!-- Roles are seeded fresh per test; a cached map would report a
             legitimately-granted permission as missing (a confusing 403). -->
        <env name="PERMISSION_CACHE_ENABLED" value="false"/>
    </php>
</phpunit>
